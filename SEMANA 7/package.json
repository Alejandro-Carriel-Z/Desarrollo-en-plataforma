{
  "name": "secureguard-semana7",
  "version": "1.0.0",
  "private": true,
  "description": "SecureGuard API: depuracion, pruebas Jest, ESLint y optimizacion sobre JWT, roles, bcrypt, HTTPS, Prisma y MySQL",
  "scripts": {
    "start": "node server.js",
    "cert": "node crear-cert.js",
    "migrate": "prisma migrate dev --config prisma7.config.ts",
