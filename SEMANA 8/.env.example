# Copia este archivo a .env (solo local) y reemplaza los marcadores. .env NUNCA se sube.
# En el hosting (Render) estas variables se crean en el panel, no en archivos.

# development | production | test
NODE_ENV=development
PORT=3000

# Conexión PostgreSQL
DATABASE_URL="postgresql://usuario:TU_CLAVE@localhost:5432/secureguard"
# true si la base exige TLS (URL externa de Render Postgres); la URL interna de Render no lo necesita
DATABASE_SSL=false

# 64 caracteres hexadecimales:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REEMPLAZA_CON_64_CARACTERES_HEX"

# HTTPS propio con certs/ (local). En producción detrás del proxy del hosting: false
HTTPS_ENABLED=true
# true cuando hay un proxy delante (Render)
TRUST_PROXY=false
# Orígenes permitidos por CORS, separados por coma. En producción SOLO se aceptan estos.
CORS_ORIGINS=

# Rate limiting del login (intentos fallidos por IP y ventana en minutos)
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15

# debug | info | warn | error ; LOG_FILE opcional (ej. logs/app.log)
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Claves de los usuarios de demostración (obligatorias si NODE_ENV=production)
SEED_ANALISTA_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_ADMIN_PASSWORD=
